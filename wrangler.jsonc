{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrsoftware",
  "main": "worker.mjs",
  "build": { "command": "npm run prepare-dashboard" },
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "mrsoftware.dk/*",
      "zone_name": "mrsoftware.dk"
    }
  ]
}
