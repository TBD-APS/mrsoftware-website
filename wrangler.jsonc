{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrsoftware",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "mrsoftware.dk/*",
      "zone_name": "mrsoftware.dk"
    }
  ]
}